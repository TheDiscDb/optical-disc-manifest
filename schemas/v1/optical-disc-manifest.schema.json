{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.thediscdb.com/optical-disc-manifest/v1/optical-disc-manifest.schema.json",
  "title": "Optical Disc Manifest v1",
  "description": "A tool-neutral manifest of observed DVD, Blu-ray, or UHD Blu-ray structure.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "producer",
    "capabilities",
    "disc"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "schemaVersion": {
      "const": 1
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "disc.identifiers",
          "disc.files.hash-inputs",
          "disc.files.complete",
          "disc.titles",
          "disc.titles.complete",
          "disc.segments",
          "disc.streams",
          "disc.chapters.counts",
          "disc.chapters.timing"
        ]
      }
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "disc": {
      "$ref": "#/$defs/disc"
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "disc.files.complete"
            }
          }
        },
        "required": [
          "capabilities"
        ]
      },
      "then": {
        "properties": {
          "disc": {
            "required": [
              "files"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "disc.titles.complete"
            }
          }
        },
        "required": [
          "capabilities"
        ]
      },
      "then": {
        "properties": {
          "disc": {
            "required": [
              "titles"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "uri": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        }
      }
    },
    "disc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format"
      ],
      "properties": {
        "format": {
          "enum": [
            "dvd",
            "blu-ray",
            "uhd-blu-ray",
            "unknown"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "identifiers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "titles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/title"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "identifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value",
        "computedBy"
      ],
      "properties": {
        "kind": {
          "enum": [
            "aacs-disc-id",
            "dvd-disc-id",
            "matrix256",
            "legacy-disc-hash"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{32,128}$"
        },
        "computedBy": {
          "enum": [
            "producer",
            "server",
            "unknown"
          ]
        },
        "algorithmVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "inputPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        }
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//).+$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sizeBytes"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "modifiedAt": {
          "type": "string",
          "format": "date-time"
        },
        "role": {
          "enum": [
            "metadata",
            "playlist",
            "stream",
            "menu",
            "backup",
            "other"
          ]
        }
      }
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "source"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "$ref": "#/$defs/titleSource"
        },
        "durationSeconds": {
          "type": "number",
          "minimum": 0
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "chapterCount": {
          "type": "integer",
          "minimum": 0
        },
        "chapters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/chapter"
          }
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/segment"
          }
        },
        "streams": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stream"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "titleSource": {
      "oneOf": [
        {
          "$ref": "#/$defs/bluRayPlaylistSource"
        },
        {
          "$ref": "#/$defs/bluRayStreamSource"
        },
        {
          "$ref": "#/$defs/dvdPgcSource"
        },
        {
          "$ref": "#/$defs/fileSource"
        },
        {
          "$ref": "#/$defs/unknownSource"
        }
      ]
    },
    "bluRayPlaylistSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path"
      ],
      "properties": {
        "kind": {
          "const": "blu-ray-playlist"
        },
        "path": {
          "allOf": [
            {
              "$ref": "#/$defs/path"
            },
            {
              "pattern": "^BDMV/PLAYLIST/[^/]+\\.[Mm][Pp][Ll][Ss]$"
            }
          ]
        }
      }
    },
    "bluRayStreamSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path"
      ],
      "properties": {
        "kind": {
          "const": "blu-ray-stream"
        },
        "path": {
          "allOf": [
            {
              "$ref": "#/$defs/path"
            },
            {
              "pattern": "^BDMV/STREAM/[^/]+\\.[Mm]2[Tt][Ss]$"
            }
          ]
        }
      }
    },
    "dvdPgcSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "titleSet",
        "pgc"
      ],
      "properties": {
        "kind": {
          "const": "dvd-pgc"
        },
        "titleSet": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "pgc": {
          "type": "integer",
          "minimum": 1
        },
        "angle": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "fileSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path"
      ],
      "properties": {
        "kind": {
          "const": "file"
        },
        "path": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "unknownSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "label"
      ],
      "properties": {
        "kind": {
          "const": "unknown"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "startSeconds": {
          "type": "number",
          "minimum": 0
        },
        "durationSeconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "clip"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "clip": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "filePath": {
          "$ref": "#/$defs/path"
        },
        "startSeconds": {
          "type": "number",
          "minimum": 0
        },
        "durationSeconds": {
          "type": "number",
          "minimum": 0
        },
        "angle": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "type",
        "codec"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "enum": [
            "video",
            "audio",
            "subtitle",
            "data",
            "unknown"
          ]
        },
        "codec": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        },
        "languageName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "audioLayout": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "resolution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "aspectRatio": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:\\.[a-z0-9-]+)+(?:/[A-Za-z0-9._~-]+)+$"
      },
      "additionalProperties": true
    }
  }
}
